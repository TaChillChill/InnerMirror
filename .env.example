# Meta Model API key from https://dev.meta.ai — server-side only, never prefix with NEXT_PUBLIC_
META_API_KEY=
META_API_BASE_URL=https://api.meta.ai/v1
# Standard (non-contributor) model only: contributor variants may train on inputs
META_TEXT_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
# "fixtures" = no network calls; "live" = real Meta API (needs approved budget)
AI_MODE=fixtures
