# Meta Model API key from https://dev.meta.ai — server-side only, never prefix with NEXT_PUBLIC_
META_API_KEY=
# The model is fixed in code to the Standard tier (muse-spark-1.3); contributor variants may train on inputs.

# Reasoning effort for /api/analyze: "medium" (default: more alternatives and second-layer notes)
# or "low" (about 30% faster and cheaper in the prompt v2 eval).
ANALYZE_EFFORT=low
# Spend cap in USD per server process for app calls. Resets on restart; it is a guard, not accounting.
APP_SPEND_CAP_USD=1
# Optional: require this code in the x-access-code header. The UI doesn't send it yet (deploy task).
ACCESS_CODE=
